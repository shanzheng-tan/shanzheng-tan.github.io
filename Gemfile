# Only needed for previewing locally (`bundle exec jekyll serve`).
# GitHub Pages builds the site itself on every push.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick"

# Windows needs timezone data and a file watcher shim
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin]
gem "wdm", "~> 0.1", platforms: [:mingw, :x64_mingw, :mswin]
